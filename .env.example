# Variable names only. Put values in your shell or in a git-ignored .env; never commit them.

# Scan workspace repo
SCAN_REPO=
SCAN_REPO_DEFAULT_BRANCH=
SCAN_WORKFLOW_FILE=
GITHUB_API_URL=
GITHUB_SERVER_URL=

# GitHub authentication: token (laptop) or app (real environment)
GITHUB_AUTH_MODE=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Callers of the HTTP API: entra (AKS) or token (laptop)
SCAN_AUTH_MODE=
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ALLOWED_CALLERS=
SCAN_API_TOKEN=
SCAN_SERVICE_URL=

# Storage and limits
SCAN_STORE_URL=
EVIDENCE_STORE_URL=
MAX_SCANS_IN_FLIGHT=
GITLEAKS_BIN=
MAX_BUNDLE_BYTES=
MAX_BUNDLE_FILES=
MAX_FILE_BYTES=
SCAN_TIMEOUT_SECONDS=
SCAN_CACHE_SECONDS=
